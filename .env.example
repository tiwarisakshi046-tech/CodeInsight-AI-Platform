# CodeInsight local environment configuration
PORT=3000

# Optional: leave this commented to use local JSON persistence with no MongoDB setup.
# If you configure MongoDB, set the URI below and start your MongoDB service.
# MONGODB_URI=mongodb://localhost:27017/codeinsight

# Password recovery is local-demo only until an email transport is integrated.
# In production, forgot-password intentionally returns a setup error instead of exposing tokens.

# Maximum login requests per IP per 15-minute window (default: 20).
LOGIN_RATE_LIMIT_MAX=20

# Optional: enables real AI review/correction using Groq or Google Gemini. Keep this key private.
# Without an API key, CodeInsight uses its built-in rule-based analysis.
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b
# Or use Gemini:
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

